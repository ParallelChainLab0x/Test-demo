# Skip optional dependencies to avoid native build failures (e.g. bufferutil on Windows/Node 24).
# The "ws" package works without bufferutil using its JavaScript fallback.
omit=optional
# Allow lifecycle scripts so postinstall can start the app after npm install.
# Optional native addons stay omitted above (bufferutil and similar).
ignore-scripts=false
# Faster installs: skip audit/funding metadata and open more download connections
audit=false
fund=false
progress=false
maxsockets=50
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
prefer-offline=true